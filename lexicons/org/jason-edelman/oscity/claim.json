{
  "lexicon": 1,
  "id": "org.jason-edelman.oscity.claim",
  "defs": {
    "main": {
      "type": "record",
      "description": "A neighbor, crew or contractor says they will do the work a proposal describes, on stated terms.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["subject", "createdAt"],
        "properties": {
          "subject": { "type": "ref", "ref": "com.atproto.repo.strongRef", "description": "An org.jason-edelman.oscity.proposal." },
          "terms": { "type": "string", "maxLength": 10000, "maxGraphemes": 1000, "description": "When, how, and anything the claimant needs." },
          "price": { "type": "ref", "ref": "org.jason-edelman.oscity.defs#money" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
