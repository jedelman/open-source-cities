{
  "lexicon": 1,
  "id": "org.jason-edelman.oscity.done",
  "defs": {
    "main": {
      "type": "record",
      "description": "The claimant says the work is finished, with what they did and photos of it.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["subject", "createdAt"],
        "properties": {
          "subject": { "type": "ref", "ref": "com.atproto.repo.strongRef", "description": "An org.jason-edelman.oscity.claim, normally the author's own." },
          "text": { "type": "string", "maxLength": 10000, "maxGraphemes": 1000 },
          "images": {
            "type": "array",
            "maxLength": 4,
            "items": { "type": "ref", "ref": "org.jason-edelman.oscity.defs#image" }
          },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
